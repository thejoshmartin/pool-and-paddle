# Pool & Paddle — required environment variables (names only; real values live in Vercel).
# Copy to `.env` for local dev. Note: `vite dev` does NOT run the /api functions, so Redis
# and Blob aren't reachable locally — only VITE_* vars affect the local SPA. Real persistence
# and receipts are tested on a deploy. See CLAUDE.md → "Setup / infra".

# Upstash Redis (source of truth). Use these explicit vars, NOT Redis.fromEnv().
PP_REDIS_URL=
PP_REDIS_TOKEN=

# Vercel Blob — receipts. The store MUST be created as PRIVATE (irreversible per store).
# Vercel auto-adds this when you connect the store to the project.
BLOB_READ_WRITE_TOKEN=

# Google Maps (Dashboard property map) — the only var that affects local `vite dev`.
VITE_GOOGLE_MAPS_KEY=

# Per-user login passwords (Josh / Kerry). When BOTH are unset, auth is bypassed (local dev).
JM_PASSWORD=
KM_PASSWORD=
